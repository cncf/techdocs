import assert from 'node:assert/strict';
import { describe, it } from 'node:test';
import sidebars from '../sidebars.ts';

// sidebars.ts is imported by docusaurus.config.ts and so is exercised by the
// e2e link-rewrite build (e2e/linkRewrite.test.mjs), but it has no unit
// coverage: c8's default (non --all) report simply omits any file that no
// unit test ever imports, so this module is invisible to the 100%
// unit-coverage gate rather than counting against it. Import it directly so
// a regression to the autogenerated docSidebar shape fails fast in the unit
// suite, without waiting on a full Docusaurus build.
describe('sidebars', () => {
  it('exports a docSidebar generated from the docs folder structure', () => {
    assert.deepEqual(sidebars, {
      docSidebar: [{ type: 'autogenerated', dirName: '.' }],
    });
  });
});
